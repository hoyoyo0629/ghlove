	<select id="getTempItemImageMigTablesByItemIdList" parameterType="java.util.HashMap" resultType="java.util.HashMap" >
        SELECT
		    ITEM_IMAGE_ID
		    , ITEM_ID
		    , IMAGE_NAME
		    , ORDERING
		    , ITEM_CODE
		    , SERIAL_NUM
		FROM TEMP_ITEM_IMAGE_MIG_TABLES
		WHERE 1=1
		AND   MIGRATION_YN = 'N'
		<if test='item_id_list != null and item_id_list != "" and item_id_list.size !=0'>
            AND ITEM_ID IN
            <foreach item="list" collection="item_id_list" open="(" separator="," close=")">
                #{list}
            </foreach>
        </if>
		ORDER BY ITEM_IMAGE_ID ASC
		<if test='count != null and count != ""'>
		    LIMIT #{count}
		</if>
    </select>
    

