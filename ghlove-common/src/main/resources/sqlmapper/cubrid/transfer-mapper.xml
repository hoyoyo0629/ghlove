    <insert id="insertOpItemImage" parameterType="java.util.HashMap" >
        INSERT INTO MIG_OP_ITEM_IMAGE (ITEM_IMAGE_ID, ITEM_ID, IMAGE_NAME, ORDERING, CREATED_DATE, SERIAL_NUM)			<!-- OP_ITEM_IMAGE 를 MIG_OP_ITEM_IMAGE 로 변경 -->
        VALUES(#{item_image_id}, #{item_id}, #{image_name}, #{ordering}, DATE_FORMAT(NOW(),'%Y%m%d%H%i%s'), #{serial_num});
    </insert>

    <update id="updateTempItemImageMigTables" parameterType="java.util.HashMap" >
        UPDATE TEMP_ITEM_IMAGE_MIG_TABLES
        SET CREATE_DATE = NOW()
          <if test='image_no == "1"'>,IMAGE_PATH1 = #{image_path}</if>
          <if test='image_no == "2"'>,IMAGE_PATH2 = #{image_path}</if>
          <if test='image_no == "3"'>,IMAGE_PATH3 = #{image_path}</if>
          <if test='image_no == "4"'>,IMAGE_PATH4 = #{image_path}</if>
          , MIGRATION_YN = 'Y'		<!-- 추가 -->
        WHERE ITEM_IMAGE_ID = #{item_image_id}
        <!-- AND ITEM_ID = #{item_id}
        AND ORDERING = #{ordering} -->
    </update>

