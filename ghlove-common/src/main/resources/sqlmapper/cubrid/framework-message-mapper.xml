<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.onlinepowers.framework.repository.mapper.MessageMapper">
	<resultMap id="messageInfoResultMap" type="com.onlinepowers.framework.repository.MessageInfo">
		<result property="key.id" 			column="ID"					javaType="string" 	jdbcType="VARCHAR" />
		<result property="key.language"		column="LANGUAGE"			javaType="string" 	jdbcType="VARCHAR" />
		<result property="messagePattern" 	column="MESSAGE"	javaType="string"  	jdbcType="VARCHAR" />
	</resultMap>

	<select id="getMessageInfo" parameterType="com.onlinepowers.framework.repository.I18nKey"
    	resultMap="messageInfoResultMap" >
		SELECT 
			ID,
			`LANGUAGE`,
			MESSAGE
		FROM 
			OP_COMMON_MESSAGE
		WHERE 
			ID = #{id, javaType=string, jdbcType=VARCHAR}
			AND `LANGUAGE` = #{language, javaType=string, jdbcType=VARCHAR}
	</select>

	<select id="getAllMessageInfos" resultMap="messageInfoResultMap" >
		SELECT 
			ID,
			`LANGUAGE`,
			MESSAGE
		FROM 
			OP_COMMON_MESSAGE
	</select>
</mapper>