				UPDATE SET SEASON_FOOD_KEYWORD = #{seasonalFoodKeyword}
			WHEN NOT MATCHED THEN		조건문에 해당하는 데이터가 없을 때 INSERT문 실행
				INSERT
						(SEASON_FOOD_MONTH
						, SEASON_FOOD_KEYWORD)
					VALUES
						(#{seasonalFoodMonth}
						, #{seasonalFoodKeyword})
			
	</update> -->
	
	
	<insert id="insertSeasonalFood" parameterType="saleson.shop.seasonalfood.domain.SeasonalFood" >
			
		INSERT INTO G_SEASON_FOOD
						(
						SEASON_FOOD_MONTH
						, SEASON_FOOD_KEYWORD
						, REG_SEQ
						, FRST_REGISTER_ID
						, FRST_REGIST_PNTTM
						, LAST_UPDUSR_ID
						, LAST_UPDT_PNTTM
						)
					VALUES
						(
						#{seasonalFoodMonth}
						, #{seasonalFoodKeyword}
						, #{regSeq}
						, #{frstRegisterId}
						, #{frstRegistPnttm}
						, #{lastUpdusrId}
						, #{lastUpdtPnttm}
						)
			
	</insert>
	
	<delete id="deleteSeasonalFood" parameterType="saleson.shop.seasonalfood.domain.SeasonalFood" >
			
		DELETE FROM G_SEASON_FOOD
			WHERE SEASON_FOOD_MONTH = #{seasonalFoodMonth}
			
	</delete>
	
	
	
</mapper>